# =============================================================================
# devbox environment template — copy to .env and edit:
#   cp .env.example .env
# Full descriptions: README "Appendix: environment variables".
# devbox 环境变量模板 —— 复制为 .env 后编辑：
#   cp .env.example .env
# 完整说明见 README「附录：环境变量参考」。
# =============================================================================

# ---- Agent installation / Agent 安装 -----------------------------------------
# Which agents to install on startup (comma-separated):
# claude / codex / opencode / grok / cursor / kimi / copilot / agy / pi / none
# 启动时安装哪些 agent（逗号分隔）：
# claude / codex / opencode / grok / cursor / kimi / copilot / agy / pi / none
AGENT=claude
# npm registry; in mainland China use https://registry.npmmirror.com
# npm 镜像；国内建议改为 https://registry.npmmirror.com 加速下载
NPM_REGISTRY=https://registry.npmjs.org
# Version pinning (optional, default latest) / 版本锁定（可选，默认 latest）
# CLAUDE_VERSION=
# CODEX_VERSION=
# OPENCODE_VERSION=
# COPILOT_VERSION=
# PI_VERSION=

# ---- Control layer (hapi | mindfs, pick one, default hapi) -------------------
#       ---- 控制层（hapi | mindfs，二选一，默认 hapi）----------------------------
# hapi  : HAPI hub + runner, supports all 9 agents (Web / PWA / Telegram Mini App)
# mindfs: MindFS single binary, supports 7 agents (Claude / Codex / OpenCode / Grok /
#         Cursor / Kimi / Copilot); Pi and Antigravity are not supported
# hapi  : HAPI hub + runner，支持全部 9 种 agent（Web / PWA / Telegram Mini App）
# mindfs: MindFS 单二进制服务，支持 7 种 agent（Claude / Codex / OpenCode / Grok /
#         Cursor / Kimi / Copilot）；Pi 与 Antigravity 不在其支持范围
CONTROL=hapi

# ---- Claude Code (set at least one agent's key) ------------------------------
#       Claude Code（至少配置一份 agent 的 key）---------------------------------
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=            # Alternative: send as a Bearer token / 备选：以 Bearer token 发送

# ---- Codex -------------------------------------------------------------------
# OPENAI_API_KEY=                   # Official key (one-time codex login --with-api-key) / 官方 key（首次 codex login --with-api-key）
# CODEX_BASE_URL=                   # Third-party gateway / 第三方网关
# CODEX_API_KEY=
# CODEX_MODEL=gpt-5.1

# ---- OpenCode ----------------------------------------------------------------
# OPENCODE_BASE_URL=                # Third-party gateway / 第三方网关
# OPENCODE_API_KEY=
# OPENCODE_MODEL=gpt-4o-mini

# ---- Grok --------------------------------------------------------------------
# XAI_API_KEY=                      # Official xAI endpoint / 官方 xAI 端点
# GROK_BASE_URL=                    # Third-party relay / 第三方中转
# GROK_API_KEY=
# GROK_MODEL=grok-4.5
# GROK_API_BACKEND=chat_completions # chat_completions / responses / messages

# ---- Kimi --------------------------------------------------------------------
# KIMI_API_KEY=

# ---- Pi (third-party only, no official backend; a provider is required) -------
#       Pi（纯第三方，无官方后端，必须配置 provider）--------------------------------
# PI_BASE_URL=
# PI_API_KEY=
# PI_MODEL=gpt-4o-mini
# PI_API=openai-completions         # openai-completions / openai-responses / anthropic-messages / google-generative-ai

# ---- Tailscale (recommended: direct phone access, no public ports) ------------
#       Tailscale（推荐配置：手机直连、免开公网端口）---------------------------------
# Generate at https://login.tailscale.com/admin/settings/keys; leave empty to disable
# 在 https://login.tailscale.com/admin/settings/keys 生成；留空则不启用 Tailscale
TS_AUTHKEY=
TS_HOSTNAME=devbox-vps
TS_SSH=true
# TS_EXTRA_ARGS=                    # Extra `tailscale up` args / 额外 tailscale up 参数

# ---- HAPI (CONTROL=hapi only) -------------------------------------------------
#       HAPI（仅 CONTROL=hapi 时生效）---------------------------------------------
# HAPI_NO_RELAY=                    # Empty=auto (Tailscale if up, else public relay); true=Tailscale only; false=force public relay
#                                   # 留空=自动（有 Tailscale 走私网、无则公共中继）；true=仅 Tailscale；false=强制公共中继
# HAPI_LISTEN_HOST=127.0.0.1
# HAPI_LISTEN_PORT=3006
# HAPI_RELAY_FORCE_TCP=false
# TELEGRAM_BOT_TOKEN=               # Optional: permission-approval push notifications / 可选：权限审批推送通知
# SERVERCHAN_SENDKEY=               # Optional: permission-approval push notifications / 可选：权限审批推送通知

# ---- MindFS (CONTROL=mindfs only) --------------------------------------------
#       MindFS（仅 CONTROL=mindfs 时生效）-----------------------------------------
# MINDFS_LISTEN_PORT=7331           # Service port / 服务端口
# MINDFS_NO_RELAYER=                # Empty=auto (Tailscale if up, else a9gent relay); true=Tailscale only; false=allow relay
#                                   # 留空=自动（有 Tailscale 走私网、无则允许 a9gent 中继）；true=仅 Tailscale；false=允许中继
# MINDFS_E2EE=false                 # true=end-to-end encryption (pairing secret printed on first start) / 启用端到端加密（首次启动打印配对密钥）

# ---- Misc / 其他 -------------------------------------------------------------
# WORKSPACE_ROOT=/workspace         # Dir the control layer may browse / create sessions in / runner 允许浏览、新建会话的目录
