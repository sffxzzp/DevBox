# =============================================================================
# devbox 环境变量模板 —— 复制为 .env 后编辑：
#   cp .env.example .env
# 完整说明见 README「附录：环境变量参考」
# =============================================================================

# ---- Agent 安装 ---------------------------------------------------------------
# 启动时安装哪些 agent（逗号分隔）：claude / codex / opencode / grok / cursor /
# kimi / copilot / agy / pi / none
AGENT=claude
# npm 镜像；国内建议改为 https://registry.npmmirror.com 加速下载
NPM_REGISTRY=https://registry.npmjs.org
# 版本锁定（可选，默认 latest）
# CLAUDE_VERSION=
# CODEX_VERSION=
# OPENCODE_VERSION=
# COPILOT_VERSION=
# PI_VERSION=

# ---- Claude Code（至少配置一份 agent 的 key）------------------------------------
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=            # 备选：以 Bearer token 发送

# ---- Codex ---------------------------------------------------------------------
# OPENAI_API_KEY=                   # 官方 key（首次 codex login --with-api-key）
# CODEX_BASE_URL=                   # 第三方网关
# CODEX_API_KEY=
# CODEX_MODEL=gpt-5.1

# ---- OpenCode ------------------------------------------------------------------
# OPENCODE_BASE_URL=                # 第三方网关
# OPENCODE_API_KEY=
# OPENCODE_MODEL=gpt-4o-mini

# ---- Grok ----------------------------------------------------------------------
# XAI_API_KEY=                      # 官方 xAI 端点
# GROK_BASE_URL=                    # 第三方中转
# GROK_API_KEY=
# GROK_MODEL=grok-4.5
# GROK_API_BACKEND=chat_completions # chat_completions / responses / messages

# ---- Kimi ----------------------------------------------------------------------
# KIMI_API_KEY=

# ---- Pi（纯第三方，无官方后端，必须配置 provider）----------------------------------
# PI_BASE_URL=
# PI_API_KEY=
# PI_MODEL=gpt-4o-mini
# PI_API=openai-completions         # openai-completions / openai-responses / anthropic-messages / google-generative-ai

# ---- Tailscale（推荐配置：手机直连、免开公网端口）-----------------------------------
# 在 https://login.tailscale.com/admin/settings/keys 生成；留空则不启用 Tailscale
TS_AUTHKEY=
TS_HOSTNAME=devbox-vps
TS_SSH=true
# TS_EXTRA_ARGS=                    # 额外 tailscale up 参数

# ---- HAPI ----------------------------------------------------------------------
# HAPI_NO_RELAY=                    # 留空=自动（有 Tailscale 走私网、无则公共中继）；true=仅 Tailscale；false=强制公共中继
# HAPI_LISTEN_HOST=127.0.0.1
# HAPI_LISTEN_PORT=3006
# HAPI_RELAY_FORCE_TCP=false
# TELEGRAM_BOT_TOKEN=               # 可选：权限审批推送通知
# SERVERCHAN_SENDKEY=               # 可选：权限审批推送通知

# ---- 其他 ----------------------------------------------------------------------
# WORKSPACE_ROOT=/workspace         # runner 允许浏览/新建会话的目录
